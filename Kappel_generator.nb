         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"do", " ", "not", " ", 
           RowBox[{"let", " ", "'"}], 
           RowBox[{"a", "'"}], " ", 
           RowBox[{"and", " ", "'"}], 
