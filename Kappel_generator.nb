       RowBox[{"ellipseType9", "[", "narocnost", "]"}], ",", 
       "\[IndentingNewLine]", "10", ",", 
       RowBox[{"ellipseType10", "[", "narocnost", "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "Function", " ", "generating", " ", "test", " ", "in", " ", "the", " ", 
      "\"\<teacher\>\"", " ", "environment", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"parameters", ":", "\[IndentingNewLine]", "  ", 
