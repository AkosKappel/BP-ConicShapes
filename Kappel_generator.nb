                TraditionalForm]]; Null]; 
           Print["ANSWER = ", $CellContext`answer]; 
           Print["GRAPH = ", $CellContext`graph]; Null]; 
         Return[{$CellContext`problem, $CellContext`steps, \
$CellContext`graph, $CellContext`answer}]; Null]}; Typeset`initDone$$ = True),
