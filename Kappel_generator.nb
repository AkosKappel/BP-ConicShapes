Cell[CellGroupData[{

Cell["Typ 5 - Elipsa ur\[CHacek]en\[AAcute] tromi bodmi", "Subsection",
 CellChangeTimes->{{3.855982452903029*^9, 3.8559824713533244`*^9}, {
   3.8559825504504957`*^9, 3.855982584051509*^9}, {3.855982698149708*^9, 
   3.855982701443842*^9}, {3.8564062655911446`*^9, 3.8564062683787374`*^9}, 
   3.8564134007176256`*^9, {3.8591105292388477`*^9, 3.859110530160873*^9}, {
   3.8593889513768005`*^9, 
   3.859388952171114*^9}},ExpressionUUID->"466fe27f-4033-4e2c-81cb-\
0648a30bd7be"],

Cell["\<\
S\[UAcute] dan\[EAcute] tri body a mus\[IAcute]me zisti\[THacek] rovnicu \
elipsy, pre ktor\[UAcute] plat\[IAcute], \[ZHacek]e prech\[AAcute]dza v\
\[SHacek]etk\[YAcute]mi tromi bodmi.
\tEasy: Zo zadania pozn\[AAcute]me s\[UAcute]radnice bodov `A`, `B`, `C` a s\
\[UAcute]radnice stredu elipsy (stred je v\[ZHacek]dy v bode [0; 0]).
\tMedium: Zo zadania pozn\[AAcute]me s\[UAcute]radnice bodov `A`, `B`, `C` a \
vieme \[ZHacek]e stred je medzi niektor\[YAcute]mi dvomi z t\[YAcute]chto \
bodov (stred je v\[ZHacek]dy mimo bodu [0; 0]).
\tHard: Zo zadania pozn\[AAcute]me s\[UAcute]radnice bodov `A`, `B`, `C` a s\
\[UAcute]radnice stredu elipsy (stred je v\[ZHacek]dy mimo bodu [0; 0]).\
\>", "Text",
 CellChangeTimes->{{3.85878071665661*^9, 3.858780728301429*^9}, {
  3.859039776210126*^9, 3.8590399107013297`*^9}, {3.8591063662774944`*^9, 
  3.859106471194522*^9}, {3.8599481839858527`*^9, 
  3.8599483162839303`*^9}},ExpressionUUID->"1ca4bb14-5404-4326-a400-\
bd01b59fb5dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ellipseType5", "[", 
    RowBox[{
     RowBox[{"problemDifficulty_", ":", "\"\<Easy\>\""}], ",", 
     RowBox[{"debug_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"difficulty", "=", "1"}], ",", 
       RowBox[{
       "standardFormula", "=", 
        "\"\<\!\(\*FractionBox[SuperscriptBox[\((x - m)\), \(2\)], \
SuperscriptBox[\(a\), \(2\)]]\) + \!\(\*FractionBox[SuperscriptBox[\((y - \
n)\), \(2\)], SuperscriptBox[\(b\), \(2\)]]\) = 1\>\""}], ",", 
       RowBox[{"prevStep", "=", "Null"}], ",", 
       RowBox[{"(*", " ", "Constants", " ", "*)"}], "\[IndentingNewLine]", 
       "randInt", ",", "appendStep", ",", "appendPrevStep", ",", "italic", 
       ",", "generateNiceRadiuses", ",", "randomNonAxisPointOnEllipse", ",", 
       "random3PointsOnEllipse", ",", "random3NonMirroredPointsOnEllipse", 
       ",", "mirrorEllipsePoint", ",", "setDifficultyParameters", ",", 
       "createGraph", ",", "solutionForKnownCenter", ",", 
       "solutionForCenterBetweenVertexPoints", ",", 
       RowBox[{"(*", " ", "Functions", " ", "*)"}], "\[IndentingNewLine]", 
       "centerRanges", ",", "niceRadiuses", ",", "orientation", ",", "pair", 
       ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Difficulty", " ", "parameters"}], " ", "*)"}], 
       "\[IndentingNewLine]", "a", ",", "b", ",", "aSquared", ",", "bSquared",
        ",", "m", ",", "n", ",", "center", ",", "ellipse", ",", "mVar", ",", 
       "nVar", ",", "aVar", ",", "bVar", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Ellipse", " ", "variables"}], " ", "*)"}], 
       "\[IndentingNewLine]", "pointA", ",", "pointB", ",", "pointC", ",", 
       "eqA", ",", "eqB", ",", "eqC", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Points", " ", "and", " ", "their", " ", "equations"}], " ", 
        "*)"}], "\[IndentingNewLine]", "eq", ",", "tmp", ",", "val", ",", "i",
        ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Local", " ", "variables"}], " ", "*)"}], 
       "\[IndentingNewLine]", "problem", ",", 
       RowBox[{"steps", "=", 
        RowBox[{"List", "[", "]"}]}], ",", "graph", ",", "answer"}], 
      RowBox[{"(*", " ", 
       RowBox[{"Return", " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ClearAll", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randInt", "[", "ranges_", "]"}], ":=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"RandomChoice", "[", "ranges", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"appendStep", "[", "step_", "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"prevStep", "=!=", "step"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"steps", ",", "step"}], "]"}], ";", 
          RowBox[{"prevStep", "=", "step"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"appendPrevStep", "[", "step_", "]"}], ":=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{
         RowBox[{"steps", "[", 
          RowBox[{"[", 
           RowBox[{"Length", "[", "steps", "]"}], "]"}], "]"}], ",", "step"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"italic", "[", "text_", "]"}], ":=", 
       RowBox[{"Style", "[", 
        RowBox[{"text", ",", "Italic"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "get", " ", "random", " ", "point", " ", "on", " ", "ellipse"}], ",", 
        " ", 
        RowBox[{
        "which", " ", "is", " ", "not", " ", "on", " ", "the", " ", "major", 
         " ", "or", " ", "minor", " ", "axis"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randomNonAxisPointOnEllipse", "[", "]"}], ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "solutions", "}"}], ",", 
         RowBox[{
          RowBox[{"solutions", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "/.", 
            RowBox[{"Solve", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"x", "-", "m"}], ")"}], "2"], "/", "aSquared"}], 
                  "+", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"y", "-", "n"}], ")"}], "2"], "/", "bSquared"}]}],
                  "==", "1"}], ",", 
                RowBox[{"x", "!=", "m"}], ",", 
                RowBox[{"y", "!=", "n"}], ",", 
                RowBox[{
                 RowBox[{"m", "-", "a"}], "<=", "x"}], ",", 
                RowBox[{"x", "<=", 
                 RowBox[{"m", "+", "a"}]}], ",", 
                RowBox[{
                 RowBox[{"n", "-", "b"}], "<=", "y"}], ",", 
                RowBox[{"y", "<=", 
                 RowBox[{"n", "+", "b"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", "Integers", ",", 
              RowBox[{"Assumptions", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"a", ">", "0"}], ",", 
                 RowBox[{"b", ">", "0"}]}], "}"}]}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "solutions", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<ERROR: no points found on ellipse\>\"", ",", "Red"}], 
               "]"}], "]"}], ";", 
             RowBox[{"Return", "[", 
              RowBox[{"{", 
               RowBox[{"Null", ",", "Null"}], "}"}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"RandomChoice", "[", "solutions", "]"}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
