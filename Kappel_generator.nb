             ",", 
            RowBox[{"difficulty", "=", "3"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Switch", "[", 
           RowBox[{"difficulty", ",", "\[IndentingNewLine]", "1", ",", 
            RowBox[{
             RowBox[{"centerRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], "}"}]}], ";", 
