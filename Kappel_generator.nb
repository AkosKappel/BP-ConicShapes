Cell[CellGroupData[{

Cell["Typ 7 - Vz\[AAcute]jomn\[AAcute] poloha priamky a elipsy", "Subsection",
 CellChangeTimes->{{3.855982452903029*^9, 3.8559824713533244`*^9}, {
   3.8559825504504957`*^9, 3.855982584051509*^9}, {3.855982698149708*^9, 
   3.855982701443842*^9}, {3.8564062655911446`*^9, 3.856406293567273*^9}, 
   3.8564133890864353`*^9},ExpressionUUID->"68497445-89d9-49b2-af30-\
38e601c447cc"],

Cell["\<\
Pri tomto pr\[IAcute]klade treba ur\[CHacek]i\[THacek] vz\[AAcute]jomn\
\[UAcute] polohu priamky `p` a elipsy. Priamka m\[AAcute] rovnak\[UAcute] \
\[SHacek]ancu by\[THacek] se\[CHacek]nicou, doty\[CHacek]nicou a \
nese\[CHacek]nicou.
\tEasy: Stred elipsy je v\[ZHacek]dy v bode [0; 0].
\tMedium: Stred elipsy je posunut\[YAcute] mimo bodu [0; 0].
\tHard: Stred elipsy je posunut\[YAcute] mimo bodu [0; 0] a nie je zadan\
\[AAcute] rovnica priamky, ale iba dva body, ktor\[EAcute] na nej \
le\[ZHacek]ia.\
\>", "Text",
 CellChangeTimes->{{3.85878071665661*^9, 3.858780728301429*^9}, 
   3.8588405049034505`*^9, {3.8590075292602654`*^9, 
   3.8590076460299025`*^9}},ExpressionUUID->"32fdbec5-01a0-437a-8aff-\
cc9970bee6de"],

