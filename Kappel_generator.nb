            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"aSquared", ">", "bSquared"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"aSquared", "=", 
               RowBox[{"bSquared", "+", "maxSquaredDifferenceAB"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"bSquared", "=", 
               RowBox[{"aSquared", "+", "maxSquaredDifferenceAB"}]}]}], 
             "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "init", " ", "difficulty", " ", "parameters", " ", "based", " ", "on", 
