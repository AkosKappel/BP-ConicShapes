                RowBox[{"aSquared", "=", 
                 RowBox[{"bSquared", "+", "minSquaredDifferenceAB"}]}], ",", 
                RowBox[{"bSquared", "=", 
                 RowBox[{"aSquared", "+", "minSquaredDifferenceAB"}]}]}], 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"aSquared", "<", "bSquared"}], ",", 
                RowBox[{"aSquared", "=", 
                 RowBox[{"bSquared", "-", "minSquaredDifferenceAB"}]}], ",", 
                RowBox[{"bSquared", "=", 
                 RowBox[{"aSquared", "-", "minSquaredDifferenceAB"}]}]}], 
               "]"}]}], "\[IndentingNewLine]", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"do", " ", "not", " ", 
            RowBox[{"let", " ", "'"}], 
            RowBox[{"a", "'"}], " ", 
            RowBox[{"and", " ", "'"}], 
            RowBox[{"b", "'"}], " ", "differ", " ", "too", " ", "much", " ", 
            RowBox[{"(", 
             RowBox[{"it", " ", "creates", " ", "flat", " ", "ellipses"}], 
             ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"aSquared", "-", "bSquared"}], "]"}], ">", 
