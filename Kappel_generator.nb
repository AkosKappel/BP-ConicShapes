Cell[CellGroupData[{

Cell["Typ 10 - Doty\[CHacek]nica k elipse", "Subsection",
 CellChangeTimes->{{3.855982452903029*^9, 3.8559824713533244`*^9}, {
   3.8559825504504957`*^9, 3.855982584051509*^9}, {3.855982698149708*^9, 
   3.855982701443842*^9}, {3.8564062655911446`*^9, 3.8564062683787374`*^9}, {
   3.856406320689006*^9, 3.856406320793747*^9}, 3.856413373821349*^9, {
   3.8591105353013277`*^9, 
   3.8591105368951674`*^9}},ExpressionUUID->"7a142c36-58ab-466a-89c7-\
d31b1eff1cc6"],

Cell["\<\
Pri tomto pr\[IAcute]klade treba zisti\[THacek] v\[SHacek]etky rovnice doty\
\[CHacek]n\[IAcute]c elipsy, ktor\[EAcute] prech\[AAcute]dzaj\[UAcute] cez \
bod `M`, ktor\[YAcute] sa nach\[AAcute]dza mimo elipsy. Elipsa je vyjadren\
\[AAcute] v stredovom tvare.
\tEasy: Elipsu treba prep\[IAcute]sa\[THacek] zo v\[SHacek]eobecnej do \
stredovej rovnice. Stred elipsy je mimo bodu [0; 0] a treba zisti\[THacek] \
doty\[CHacek]nicu, ktor\[AAcute] m\[AAcute] s elipsou bod dotyku P.
\tMedium: Stred elipsy je posunut\[YAcute] mimo bodu [0; 0] a pozn\[AAcute]me \
rovnicu priamky, ktor\[AAcute] prech\[AAcute]dza dotykov\[YAcute]mi bodmi.
\tHard: Stred elipsy je posunut\[YAcute] mimo bodu [0; 0] a nepozn\[AAcute]me \
rovnicu priamky, ktor\[AAcute] prech\[AAcute]dza dotykov\[YAcute]mi bodmi \
(najprv si ju mus\[IAcute]me zisti\[THacek]).\
\>", "Text",
 CellChangeTimes->{{3.85878071665661*^9, 3.858780728301429*^9}, 
   3.8588405179873805`*^9, {3.8592098782668333`*^9, 3.8592099637268453`*^9}, {
   3.859257839917794*^9, 3.859257869253685*^9}, {3.8592589405298724`*^9, 
   3.859259012840215*^9}, {3.859303878557581*^9, 3.8593039970529766`*^9}, {
   3.8614601191589746`*^9, 
   3.861460213748985*^9}},ExpressionUUID->"ffcde1ff-6965-4f80-95b8-\
e16bda28be27"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ellipseType10", "[", 
    RowBox[{
     RowBox[{"problemDifficulty_", ":", "\"\<Easy\>\""}], ",", 
     RowBox[{"debug_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"difficulty", "=", "1"}], ",", 
       RowBox[{
       "standardFormula", "=", 
        "\"\<\!\(\*FractionBox[SuperscriptBox[\((x - m)\), \(2\)], \
SuperscriptBox[\(a\), \(2\)]]\) + \!\(\*FractionBox[SuperscriptBox[\((y - \
n)\), \(2\)], SuperscriptBox[\(b\), \(2\)]]\) = 1\>\""}], ",", 
       RowBox[{
       "ellipseTangentFormula", "=", 
        "\"\<\!\(\*SuperscriptBox[\(b\), \(2\)]\)(\!\(\*SubscriptBox[\(x\), \
\(1\)]\)-m)(x-m) + \!\(\*SuperscriptBox[\(a\), \
\(2\)]\)(\!\(\*SubscriptBox[\(y\), \(1\)]\)-n)(y-n) = \
\!\(\*SuperscriptBox[\(a\), \(2\)]\)\!\(\*SuperscriptBox[\(b\), \
\(2\)]\)\>\""}], ",", 
       RowBox[{"prevStep", "=", "Null"}], ",", 
       RowBox[{"(*", " ", "Constants", " ", "*)"}], "\[IndentingNewLine]", 
       "appendStep", ",", "randInt", ",", "italic", ",", 
       "equationToGeneralForm", ",", "equationToFunctionForm", ",", 
       "prettyEllipseGeneralFrom", ",", "tangentThroughPoint", ",", 
       "searchForNiceParameters", ",", "initGeneralFormCoefficients", ",", 
       "createGraph", ",", "setDifficultyParameters", ",", "extractValues", 
       ",", "ellipseGeneralFormToStandardForm", ",", 
       "lineIntoEllipseSubstitution", ",", 
       RowBox[{"(*", " ", "Functions", " ", "*)"}], "\[IndentingNewLine]", 
       "centerRanges", ",", "niceProblems", ",", 
       RowBox[{"(*", " ", 
