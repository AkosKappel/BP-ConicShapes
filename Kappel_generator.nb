Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ellipseType4", "[", 
    RowBox[{
     RowBox[{"problemDifficulty_", ":", "\"\<Easy\>\""}], ",", 
     RowBox[{"debug_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"difficulty", "=", "1"}], ",", 
       RowBox[{
       "standardFormula", "=", 
        "\"\<\!\(\*FractionBox[SuperscriptBox[\((x - m)\), \(2\)], \
SuperscriptBox[\(a\), \(2\)]]\) + \!\(\*FractionBox[SuperscriptBox[\((y - \
n)\), \(2\)], SuperscriptBox[\(b\), \(2\)]]\) = 1\>\""}], ",", 
       RowBox[{"parametricFormula", "=", 
        RowBox[{"{", 
         RowBox[{
         "\"\<x = a * cos(t) + m\>\"", ",", "\"\<y = b * sin(t) + n\>\""}], 
         "}"}]}], ",", 
       RowBox[{"prevStep", "=", "Null"}], ",", 
       RowBox[{"(*", " ", "Constants", " ", "*)"}], "\[IndentingNewLine]", 
       "randInt", ",", "appendStep", ",", "italic", ",", 
       "equationToGeneralForm", ",", "prettyEllipseGeneralFrom", ",", 
       "prettifyEllipseParamaters", ",", "initGeneralFormCoefficients", ",", 
       "setDifficultyParameters", ",", "createGraph", ",", 
       "ellipseStandardFormToGeneralForm", ",", 
       RowBox[{"(*", " ", "Functions", " ", "*)"}], "\[IndentingNewLine]", 
       "centerRanges", ",", "radiusRanges", ",", "complicateRanges", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Difficulty", " ", "parameters"}], " ", "*)"}], 
       "\[IndentingNewLine]", "a", ",", "b", ",", "aSquared", ",", "bSquared",
        ",", "m", ",", "n", ",", "valA", ",", "valB", ",", "valC", ",", 
       "valD", ",", "valE", ",", "center", ",", "ellipse", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Variables", " ", "for", " ", "ellipse"}], " ", "*)"}], 
       "\[IndentingNewLine]", "i", ",", "eq", ",", "eqX", ",", "eqY", ",", 
       "gcd", ",", "tmp", ",", "tmpX", ",", "tmpY", ",", "ints", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Local", " ", "variables"}], " ", "*)"}], 
       "\[IndentingNewLine]", "problem", ",", 
       RowBox[{"steps", "=", 
        RowBox[{"List", "[", "]"}]}], ",", "graph", ",", "answer"}], 
      RowBox[{"(*", " ", 
       RowBox[{"Return", " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ClearAll", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"global", " ", "variables"}], " ", "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"function", " ", "definitions"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"appendStep", "[", "step_", "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"prevStep", "=!=", "step"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"steps", ",", "step"}], "]"}], ";", 
          RowBox[{"prevStep", "=", "step"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"randInt", "[", "ranges_", "]"}], ":=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"RandomChoice", "[", "ranges", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"equationToGeneralForm", "[", "equation_", "]"}], ":=", 
       RowBox[{"Equal", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"equation", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{"equation", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", "0"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"italic", "[", "text_", "]"}], ":=", 
       RowBox[{"Style", "[", 
        RowBox[{"text", ",", "Italic"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "return", " ", "string", " ", "of", " ", "general", " ", "equation", 
         " ", "of", " ", "an", " ", "ellipse", " ", "in", " ", "standard", 
         " ", 
         RowBox[{"order", ":", " ", 
          RowBox[{
           SuperscriptBox["Ax", "2"], " ", "+", " ", 
           SuperscriptBox["By", "2"], " ", "+", " ", "Cx", " ", "+", " ", 
           "Dy", " ", "+", " ", "E"}]}]}], " ", "=", " ", "0"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"prettyEllipseGeneralFrom", "[", "]"}], ":=", 
       RowBox[{"StringForm", "[", 
        RowBox[{
        "\"\<\!\(\*SuperscriptBox[\(``x\), \(2\)]\) + \
\!\(\*SuperscriptBox[\(``y\), \(2\)]\) ``= 0\>\"", ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"valA", "!=", "1"}], ",", "valA", ",", "\"\<\>\""}], "]"}],
          ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"valB", "!=", "1"}], ",", "valB", ",", "\"\<\>\""}], "]"}],
          ",", 
         RowBox[{"(*", " ", 
          RowBox[{
          "A", " ", "and", " ", "B", " ", "are", " ", "always", " ", 
           "positive"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<``````\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"valC", "!=", "0"}], ",", 
             RowBox[{"StringForm", "[", 
              RowBox[{"\"\<`` ``x \>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"valC", ">", "0"}], ",", "\"\<+\>\"", ",", 
                 "\"\<-\>\""}], "]"}], ",", 
               RowBox[{"Abs", "[", "valC", "]"}]}], "]"}], ",", "\"\<\>\""}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"valD", "!=", "0"}], ",", 
             RowBox[{"StringForm", "[", 
              RowBox[{"\"\<`` ``y \>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"valD", ">", "0"}], ",", "\"\<+\>\"", ",", 
                 "\"\<-\>\""}], "]"}], ",", 
               RowBox[{"Abs", "[", "valD", "]"}]}], "]"}], ",", "\"\<\>\""}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"valE", "!=", "0"}], ",", 
             RowBox[{"StringForm", "[", 
              RowBox[{"\"\<`` `` \>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"valE", ">", "0"}], ",", "\"\<+\>\"", ",", 
                 "\"\<-\>\""}], "]"}], ",", 
               RowBox[{"Abs", "[", "valE", "]"}]}], "]"}], ",", "\"\<\>\""}], 
            "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"calculate", " ", "values", " ", "A"}], ",", " ", "B", ",", 
        " ", "C", ",", " ", 
        RowBox[{"D", " ", "and", " ", "E", " ", 
         RowBox[{"for", ":", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"A", 
             TemplateBox[{"x", "2"},
              "Superscript"]}], " ", "+", " ", 
            RowBox[{"B", 
             TemplateBox[{"y", "2"},
              "Superscript"]}], " ", "+", " ", "Cx", " ", "+", " ", "Dy", " ",
             "+", " ", "E"}], " ", "==", " ", "0"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"initGeneralFormCoefficients", "[", 
        RowBox[{"simplifyToBase_", ":", "True"}], "]"}], ":=", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"valA", "=", "bSquared"}], ";", "\[IndentingNewLine]", 
         RowBox[{"valB", "=", "aSquared"}], ";", "\[IndentingNewLine]", 
         RowBox[{"valC", "=", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "m", "*", "valA"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"valD", "=", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "n", "*", "valB"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"valE", "=", 
          RowBox[{
           RowBox[{"valA", "*", 
            RowBox[{"m", "^", "2"}]}], "+", 
           RowBox[{"valB", "*", 
            RowBox[{"n", "^", "2"}]}], "-", 
           RowBox[{"valA", "*", "valB"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "simplifyToBase", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"gcd", "=", 
             RowBox[{"GCD", "[", 
              RowBox[{
              "valA", ",", "valB", ",", "valC", ",", "valD", ",", "valE"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"gcd", "!=", "1"}], ",", 
              RowBox[{
               RowBox[{"valA", "/=", "gcd"}], ";", 
               RowBox[{"valB", "/=", "gcd"}], ";", 
               RowBox[{"valC", "/=", "gcd"}], ";", 
               RowBox[{"valD", "/=", "gcd"}], ";", 
               RowBox[{"valE", "/=", "gcd"}]}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}]}], ")"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"prettifyEllipseParamaters", "[", "]"}], ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"minDifferenceAB", "=", "2"}], ",", 
           RowBox[{"maxDifferenceAB", "=", "5"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"do", " ", "not", " ", 
           RowBox[{"let", " ", "'"}], 
           RowBox[{"a", "'"}], " ", 
           RowBox[{"and", " ", "'"}], 
           RowBox[{"b", "'"}], " ", "be", " ", "too", " ", "similar", " ", 
           RowBox[{"(", 
            RowBox[{
            "final", " ", "ellipse", " ", "looks", " ", "like", " ", "a", " ",
              "circle"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"a", "-", "b"}], "]"}], "<", "minDifferenceAB"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "<=", "minDifferenceAB"}], "&&", 
               RowBox[{"b", "<=", "minDifferenceAB"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"a", ">", "b"}], ",", 
                RowBox[{"a", "=", 
                 RowBox[{"b", "+", "minDifferenceAB"}]}], ",", 
                RowBox[{"b", "=", 
                 RowBox[{"a", "+", "minDifferenceAB"}]}]}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"a", "<", "b"}], ",", 
                RowBox[{"a", "=", 
                 RowBox[{"b", "-", "minDifferenceAB"}]}], ",", 
                RowBox[{"b", "=", 
                 RowBox[{"a", "-", "minDifferenceAB"}]}]}], "]"}]}], "]"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"do", " ", "not", " ", 
            RowBox[{"let", " ", "'"}], 
            RowBox[{"a", "'"}], " ", 
            RowBox[{"and", " ", "'"}], 
            RowBox[{"b", "'"}], " ", "differ", " ", "too", " ", "much", " ", 
            RowBox[{"(", 
             RowBox[{"it", " ", "creates", " ", "flat", " ", "ellipses"}], 
             ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"a", "-", "b"}], "]"}], ">", "maxDifferenceAB"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"a", ">", "b"}], ",", 
              RowBox[{"a", "=", 
               RowBox[{"b", "+", "maxDifferenceAB"}]}], ",", 
              RowBox[{"b", "=", 
               RowBox[{"a", "+", "maxDifferenceAB"}]}]}], "]"}]}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"setDifficultyParameters", "[", "]"}], ":=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<lahke\>\"", ",", "\"\<easy\>\""}], "}"}], ",", 
              RowBox[{"ToLowerCase", "[", "problemDifficulty", "]"}]}], "]"}],
             ",", 
            RowBox[{"difficulty", "=", "1"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<stredne\>\"", ",", "\"\<medium\>\""}], "}"}], ",", 
              RowBox[{"ToLowerCase", "[", "problemDifficulty", "]"}]}], "]"}],
             ",", 
            RowBox[{"difficulty", "=", "2"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<tazke\>\"", ",", "\"\<hard\>\""}], "}"}], ",", 
              RowBox[{"ToLowerCase", "[", "problemDifficulty", "]"}]}], "]"}],
             ",", 
            RowBox[{"difficulty", "=", "3"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Switch", "[", 
           RowBox[{"difficulty", ",", "\[IndentingNewLine]", "1", ",", 
            RowBox[{
             RowBox[{"centerRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], "}"}]}], ";", 
             RowBox[{"radiusRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "5"}], "}"}], "}"}]}], ";", 
             RowBox[{"complicateRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "}"}]}]}], ",", 
            "\[IndentingNewLine]", "2", ",", 
            RowBox[{
             RowBox[{"centerRanges", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "3"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "3"}], "}"}]}], "}"}]}], ";", 
             RowBox[{"radiusRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "6"}], "}"}], "}"}]}], ";", 
             RowBox[{"complicateRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "}"}]}]}], ",", 
            "\[IndentingNewLine]", "3", ",", 
            RowBox[{
             RowBox[{"centerRanges", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "5"}], ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "5"}], "}"}]}], "}"}]}], ";", 
             RowBox[{"radiusRanges", "=", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"1", ",", "6"}], "}"}], "}"}]}], ";", 
             RowBox[{"complicateRanges", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "15"}], ",", 
                  RowBox[{"-", "2"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "15"}], "}"}]}], "}"}]}]}]}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"select", " ", "difficulty"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"setDifficultyParameters", "[", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"generate", " ", "random", " ", "values"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"randInt", "[", "radiusRanges", "]"}]}], ";", 
      RowBox[{"b", "=", 
       RowBox[{"randInt", "[", "radiusRanges", "]"}]}], ";", 
      RowBox[{"m", "=", 
       RowBox[{"randInt", "[", "centerRanges", "]"}]}], ";", 
      RowBox[{"n", "=", 
       RowBox[{"randInt", "[", "centerRanges", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"prettifyEllipseParamaters", "[", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"hardcoded", " ", "values", " ", "for", " ", "testing"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"a", "=", "6"}], ";", 
        RowBox[{"b", "=", "5"}], ";", 
        RowBox[{"m", "=", "2"}], ";", 
        RowBox[{"n", "=", 
         RowBox[{"-", "3"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"init", " ", "ellipse", " ", "variables"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"aSquared", "=", 
       RowBox[{"a", "*", "a"}]}], ";", 
      RowBox[{"bSquared", "=", 
       RowBox[{"b", "*", "b"}]}], ";", 
      RowBox[{"center", "=", 
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"initGeneralFormCoefficients", "[", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellipse", "=", 
       RowBox[{"Equal", "[", 
        RowBox[{
         RowBox[{"Plus", "[", 
          RowBox[{
           RowBox[{"FractionBox", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", "m"}], ")"}], "^", "2"}], ",", "aSquared"}], 
            "]"}], ",", 
           RowBox[{"FractionBox", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", "-", "n"}], ")"}], "^", "2"}], ",", "bSquared"}], 
            "]"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "parametric", " ", "equations", " ", "for", " ", "generated", " ", 
        "ellipse"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"eqX", "=", 
       RowBox[{"Equal", "[", 
        RowBox[{"\"\<x\>\"", ",", 
         RowBox[{
          RowBox[{"a", "*", 
           RowBox[{"Cos", "[", "\"\<t\>\"", "]"}]}], "+", "m"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"eqY", "=", 
       RowBox[{"Equal", "[", 
        RowBox[{"\"\<y\>\"", ",", 
         RowBox[{
          RowBox[{"b", "*", 
           RowBox[{"Sin", "[", "\"\<t\>\"", "]"}]}], "+", "n"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "multiply", " ", "equation", " ", "with", " ", "random", " ", 
        "integer", " ", "for", " ", "highier", " ", "difficulty"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ints", "=", 
       RowBox[{"List", "[", 
        RowBox[{
         RowBox[{"randInt", "[", "complicateRanges", "]"}], ",", 
         RowBox[{"randInt", "[", "complicateRanges", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"difficulty", "==", "3"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tmpX", "=", "eqX"}], ";", 
         RowBox[{"eqX", "=", 
          RowBox[{"equationToGeneralForm", "[", 
           RowBox[{"MultiplySides", "[", 
            RowBox[{"eqX", ",", 
             RowBox[{"ints", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tmpY", "=", "eqY"}], ";", 
         RowBox[{"eqY", "=", 
          RowBox[{"equationToGeneralForm", "[", 
           RowBox[{"MultiplySides", "[", 
            RowBox[{"eqY", ",", 
             RowBox[{"ints", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"vizualize", " ", "ellipse"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"createGraph", "[", "]"}], ":=", 
       RowBox[{"Block", "[", 
