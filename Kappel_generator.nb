       RowBox[{"randInt", "[", "radiusSquaredRanges", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"randInt", "[", "centerRanges", "]"}]}], ";", 
      RowBox[{"n", "=", 
       RowBox[{"randInt", "[", "centerRanges", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"prettifyEllipseParamaters", "[", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "hardcoded", " ", "values", " ", "for", " ", "testing", " ", 
        "purpose"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"aSquared", "=", "9"}], ";", 
        RowBox[{"bSquared", "=", "24"}], ";", 
        RowBox[{"m", "=", 
         RowBox[{"-", "1"}]}], ";", 
        RowBox[{"n", "=", 
         RowBox[{"-", "5"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"initialize", " ", "ellipse"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"center", "=", 
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"Sqrt", "[", "aSquared", "]"}]}], ";", 
      RowBox[{"b", "=", 
       RowBox[{"Sqrt", "[", "bSquared", "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"aSquared", ",", "bSquared"}], "]"}], "-", 
         RowBox[{"Min", "[", 
          RowBox[{"aSquared", ",", "bSquared"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ellipse", "=", 
       RowBox[{"Equal", "[", 
        RowBox[{
         RowBox[{"Plus", "[", 
          RowBox[{
           RowBox[{"FractionBox", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", "m"}], ")"}], "^", "2"}], ",", "aSquared"}], 
            "]"}], ",", 
           RowBox[{"FractionBox", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
