      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"prettyEllipseGeneralFrom", "[", "]"}], ":=", 
       RowBox[{"StringForm", "[", 
        RowBox[{
        "\"\<\!\(\*SuperscriptBox[\(``x\), \(2\)]\) + \
\!\(\*SuperscriptBox[\(``y\), \(2\)]\) ``= 0\>\"", ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"valA", "!=", "1"}], ",", "valA", ",", "\"\<\>\""}], "]"}],
          ",", 
         RowBox[{"If", "[", 
          RowBox[{
