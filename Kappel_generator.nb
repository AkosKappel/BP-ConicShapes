          ",", 
         RowBox[{"(*", " ", 
          RowBox[{
          "A", " ", "and", " ", "B", " ", "are", " ", "always", " ", 
           "positive"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<``````\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"valC", "!=", "0"}], ",", 
             RowBox[{"StringForm", "[", 
              RowBox[{"\"\<`` ``x \>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"valC", ">", "0"}], ",", "\"\<+\>\"", ",", 
                 "\"\<-\>\""}], "]"}], ",", 
